    def get_fear_greed_index(self):
        now = time.time()
        if (now - self._fng_cache_ts) < self._fng_cache_ttl:
            return int(self._fng_cache_value)
        try:
            r = requests.get("https://api.alternative.me/fng/?limit=1", timeout=5)
