{
  "snapshot": {
    "enabled": true,
    "interval_cycles": 10,
    "directory": "./snapshots",
    "retention_days": 30,
    "version": "1.0"
  },
  
  "log_rotation": {
    "enabled": true,
    "max_size_mb": 50,
    "backup_count": 5,
    "compress": true
  },
  
  "safe_mode": {
    "enabled": true,
    "triggers": {
      "daily_loss_percent": -5.0,
      "drawdown_percent": -10.0,
      "consecutive_losses": 5,
      "api_errors_threshold": 10
    },
    "actions": {
      "pause_new_entries": true,
      "close_positions": false,
      "alert": true
    }
  },
  
  "kill_switch": {
    "enabled": true,
    "triggers": {
      "daily_loss_percent": -10.0,
      "consecutive_api_errors": 20,
      "position_stuck_hours": 24
    }
  },
  
  "rate_limiting": {
    "enabled": true,
    "binance_limit_per_min": 1000,
    "safety_margin_percent": 20,
    "burst_limit": 50
  },
  
  "graceful_degradation": {
    "enabled": true,
    "api_timeout_seconds": 5,
    "max_retries": 3,
    "skip_cycle_on_error": true
  },
  
  "idempotency": {
    "enabled": true,
    "cache_ttl_seconds": 300,
    "cache_directory": "./trade_cache"
  },
  
  "timeline_events": {
    "enabled": true,
    "directory": "./timelines",
    "events_to_track": ["entry", "breakeven", "trailing_update", "exit"]
  }
}
